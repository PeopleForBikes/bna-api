set positional-arguments

# Define variables.
top_dir := `git rev-parse --show-toplevel`

# Schemathesis release run by uvx, and the date after which uv considers no
# package when resolving its dependencies: both change together.
schemathesis := "schemathesis@4.33.4"
schemathesis_exclude_newer := "2026-11-13"

# Export the OpenAPI specification.
openapi-export:
    aws apigatewayv2 export-api \
      --api-id ivyvugk79e \
      --output-type YAML \
      --specification OAS30 \
      --no-include-extensions \
      openapi.yaml

# Runs every endpoint and scenario file, and writes a JSON report in reports/.
# Run the integration tests against an environment [localhost, staging].
test *env:
    rm -rf reports
    hurl --test \
      --variables-file $1.vars \
      --report-json reports \
      endpoints/*.hurl \
      scenario/*.hurl

# Fails when a documented status code was never observed, when an observed one
# is not documented, or when a request matches no operation.
# Compare the report of the last test run with the OpenAPI specification.
coverage:
    cargo run -q -p hurl-coverage

# Run the smoke tests against an environment [localhost, staging].
test-smoke-public *env:
    hurl --test --variables-file $1.vars smoke/public.hurl

# Settings are in schemathesis.toml. Needs uv, and the API on localhost:3000.
# Run Schemathesis against the local server.
test-schemathesis:
    uvx --python 3.13 --exclude-newer {{ schemathesis_exclude_newer }} \
      {{ schemathesis }} run {{ top_dir }}/openapi-3.1.yaml

# Uses a dedicated database, dropped and recreated on each run.
# Generate the test database dump from the migrations, baseline.sql and fixtures.sql.
dump-test-data admin_url="postgresql://postgres:postgres@localhost:5432/postgres" db="bna_test_data":
    #!/usr/bin/env bash
    set -euo pipefail
    admin_url="{{ admin_url }}"
    db="{{ db }}"
    db_url="${admin_url%/*}/${db}"
    if [ "${db_url}" = "${admin_url}" ]; then
      echo "The test database must differ from the admin database." >&2
      exit 1
    fi
    psql "${admin_url}" -v ON_ERROR_STOP=1 -q \
      -c "DROP DATABASE IF EXISTS ${db}" \
      -c "CREATE DATABASE ${db}"
    sea-orm-cli migrate up -d {{ top_dir }}/migration -u "${db_url}"
    psql "${db_url}" -v ON_ERROR_STOP=1 -q -f baseline.sql > /dev/null
    psql "${db_url}" -v ON_ERROR_STOP=1 -q -f fixtures.sql > /dev/null
    # Pin the migration timestamps so regenerating the dump yields the same data.
    psql "${db_url}" -v ON_ERROR_STOP=1 -q -c "UPDATE public.seaql_migrations SET applied_at = 0"
    # A fixed restrict key keeps the output stable (pg_dump >= 17.6 adds a random one).
    pg_dump "${db_url}" --no-owner --no-privileges --restrict-key=bnatestdata \
      -f database-with-test-data.sql
    psql "${admin_url}" -v ON_ERROR_STOP=1 -q -c "DROP DATABASE ${db}"
